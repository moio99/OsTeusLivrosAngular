    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.6",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "apexcharts": "^6.5.0",
    "ng-apexcharts": "^2.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.8",
